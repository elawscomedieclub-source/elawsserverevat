# EVAT — variables d'environnement du serveur.
# À copier dans Render → Environment. Ne mettez JAMAIS de vraies clés dans GitHub.
# Légende : [INDISPENSABLE] [CONSEILLÉ] [FACULTATIF : la fonction reste éteinte sans cette variable]

# ---- Sécurité ----
ADMIN_TOKEN=                      # [INDISPENSABLE] 24 caractères aléatoires minimum : clé de /admin et /diagnostic
ALLOWED_ORIGINS=https://elawsevat.vercel.app   # [INDISPENSABLE] adresse(s) de votre site, séparées par des virgules

# ---- Données durables (sinon tout est perdu à chaque redémarrage de Render) ----
UPSTASH_REDIS_REST_URL=           # [INDISPENSABLE]
UPSTASH_REDIS_REST_TOKEN=         # [INDISPENSABLE]
# DATA_DIR=/data                  # [FACULTATIF] dossier d'un disque persistant Render (alternative à Upstash)
BACKUP_KEY=                       # [CONSEILLÉ] 16 caractères minimum : chiffre les sauvegardes de compte. À GARDER précieusement.

# ---- Intelligence artificielle (Mister ELAWS, Mister I, traduction) ----
ANTHROPIC_API_KEY=                # [INDISPENSABLE pour l'IA] (ou GEMINI_API_KEY)
GEMINI_API_KEY=                   # [FACULTATIF] secours / alternative
# AI_ENABLED=true                 # [FACULTATIF] mettre false pour couper l'IA en urgence
# AI_DAILY_LIMIT=  AI_GLOBAL_DAILY_LIMIT=  AI_MAX_TOKENS=               # [FACULTATIF] plafonds de coût
# AI_MODEL_GENERAL=  AI_MODEL_METIER=  AI_MODEL_ROUTER=  GEMINI_MODEL=  # [FACULTATIF] choix des modèles

# ---- Notifications et appels ----
VAPID_SECRET=                     # [CONSEILLÉ] un long mot secret : garde les notifications valables après redémarrage
VAPID_SUBJECT=mailto:vous@exemple.com
CF_TURN_KEY_ID=                   # [CONSEILLÉ] relais d'appels Cloudflare : sans lui, beaucoup d'appels échouent en 3G/4G
CF_TURN_API_TOKEN=
# (autre relais : TURN_URLS, TURN_USERNAME, TURN_CREDENTIAL ou TURN_SECRET)
FIREBASE_SERVICE_ACCOUNT=         # [FACULTATIF] seulement si vous diffusez l'APK Android natif

# ---- Récupération de compte par code ----
BREVO_API_KEY=                    # [FACULTATIF] e-mail (Brevo)
MAIL_FROM=                        #   adresse d'expéditeur VALIDÉE chez Brevo
MAIL_FROM_NAME=EVAT
AT_USERNAME=                      # [FACULTATIF] SMS (Africa's Talking) ; « sandbox » = test sans vrai SMS
AT_API_KEY=
AT_SENDER=

# ---- Recherche métier sur Internet ----
BRAVE_API_KEY=                    # [FACULTATIF] sans clé : Wikipédia + Wikimedia Commons seulement

# ---- Paiement mobile (T-Money, Flooz) ----
FEDAPAY_SECRET_KEY=               # [FACULTATIF] sans clé : paiements validés à la main dans /admin
FEDAPAY_ENV=sandbox               #   sandbox pour tester, live pour de vrai
FEDAPAY_WEBHOOK_SECRET=           #   déclarer chez FedaPay : https://VOTRE-SERVEUR/webhooks/fedapay

# ---- Applis partenaires (cantine, MikroTik…) ----
PARTNER_KEYS=                     # [FACULTATIF] nom:clé,nom:clé — clé de 24 caractères minimum
PARTNER_CALLBACK_HOSTS=           #   domaines autorisés pour les rappels, ex : cantine.exemple.com
