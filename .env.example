# Copier ces noms dans Render > Environment (ne jamais mettre de vraies clés sur GitHub)
ADMIN_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@exemple.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
FIREBASE_SERVICE_ACCOUNT=
ALLOWED_ORIGINS=https://elawsevat.vercel.app

# ---- Intégrations (facultatif : tout reste désactivé tant que ce n'est pas rempli) ----
# Clés des applis partenaires (cantine, MikroTik…) : nom:clé, clé de 24 caractères minimum
PARTNER_KEYS=cantine:REMPLACER_PAR_UNE_CLE_LONGUE_ET_ALEATOIRE,mikrotik:AUTRE_CLE_LONGUE_ET_ALEATOIRE
# Domaines autorisés pour les rappels (webhooks) vers les applis partenaires
PARTNER_CALLBACK_HOSTS=cantine.exemple.com,mikrotik.exemple.com
# Paiement mobile (FedaPay : T-Money, Flooz)
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=
# SMS (Africa's Talking) — pour les messages partenaires sans compte EVAT
AT_USERNAME=
AT_API_KEY=
AT_SENDER=

# ---- Récupération de compte par code + sauvegarde cloud (v4.16) ----
# E-mail (Brevo, gratuit 300/jour) : clé API + adresse d'expéditeur VALIDÉE dans Brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=EVAT
# Chiffre les sauvegardes sur le serveur (AES-256) : 16 caractères minimum, à garder précieusement
BACKUP_KEY=
# Les SMS utilisent AT_USERNAME / AT_API_KEY (voir plus haut) ; la durabilité utilise UPSTASH_REDIS_REST_URL / _TOKEN

# ---- Recherche métier sur Internet (v4.18) ----
# Clé Brave Search API (web + images + vidéos). Sans clé : Wikipédia + Wikimedia Commons seulement.
BRAVE_API_KEY=

